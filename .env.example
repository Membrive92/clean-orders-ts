# Environment
NODE_ENV=development

# Server Configuration
PORT=3000

# Database Configuration
# Docker PostgreSQL runs on port 54320 (to avoid conflicts with local PostgreSQL on 5432)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54320/clean_orders

# External Services
PRICING_BASE_URL=https://localhost:4000

# Repository Mode
# true  = In-memory repositories (no database required, faster for testing)
# false = PostgreSQL repositories (requires DATABASE_URL and running PostgreSQL)
USE_INMEMORY=false

# Logging Configuration
LOG_LEVEL=info
