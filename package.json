{
  "name": "clean-orders-ts",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "npm run db:down && npm run db:up && timeout /t 5 /nobreak && npm run db:migrate",
    "worker:outbox": "tsx src/infrastructure/messaging/OutboxDispatcher.ts",
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:unit": "vitest run test/domain test/acceptance",
    "test:integration": "vitest run test/integration",
    "test:all": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "fastify": "^4.29.1",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.0.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.0.0"
  }
}
